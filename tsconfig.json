{
  "compilerOptions": {
    "rewriteRelativeImportExtensions": true,
    "target": "ES2024",
    "module": "ESNext",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "rootDirs": ["./lib", "./src"],
    "declaration": true,
    "outDir": "./lib",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "lib": ["ESNext"],
    "libReplacement": true,
    "types": ["vitest/globals"],
  },
  "include": ["src/**/*", "test/**/*", "docs/**/*.ts", "eslint.config.ts", ".github/scripts/**/*.ts"],
  "exclude": ["node_modules", "lib"]
}
